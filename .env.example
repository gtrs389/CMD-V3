# ---------------------------------------------------------------------------
# Autenticacao provisoria do ADMIN
#
# Nesta etapa nao existe banco de dados. As credenciais ficam apenas no
# servidor (variaveis de ambiente) e nunca sao enviadas ao navegador.
# Nenhuma variavel abaixo usa o prefixo NEXT_PUBLIC_, justamente para que
# nada disso seja embutido no pacote do cliente.
#
# 1. Copie este arquivo para .env.local
# 2. Gere o hash da senha com:  npm run gerar-hash -- "sua-senha"
# 3. Cole o valor em ADMIN_PASSWORD_HASH
# ---------------------------------------------------------------------------

# Chave usada para assinar o cookie de sessao (HMAC-SHA256).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="troque-por-uma-chave-aleatoria-de-32-bytes"

# E-mail do administrador.
ADMIN_EMAIL="admin@exemplo.com"

# Nome exibido no painel (opcional).
ADMIN_NAME="Administrador"

# Hash scrypt da senha, no formato scrypt$salt$hash.
# Sem esta variavel o sistema entra em modo de demonstracao com a
# credencial admin@exemplo.com / equipe123, exibindo aviso na tela de login.
ADMIN_PASSWORD_HASH=""
